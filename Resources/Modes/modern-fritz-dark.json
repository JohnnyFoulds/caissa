{
  "name": "Modern Fritz Dark",
  "description": "Fritz-inspired dark skin: boots into Infinite Analysis, same layout as Modern Fritz.",
  "icon": "Kibitzers",

  "hook": "modern_fritz",

  "menu_keys": null,

  "toolbar": [
    "TB_OPTIONS",
    "TB_CANCEL", "TB_CLOSE", "TB_QUIT",
    "TB_STOP", "TB_TUTOR_STOP", "TB_END_REPLAY",
    "TB_RESIGN", "TB_DRAW", "TB_TAKEBACK", "TB_REINIT",
    "TB_PAUSE", "TB_CONTINUE",
    "TB_CONFIG", "TB_UTILITIES",
    "TB_ADVICE", "TB_HELP",
    "TB_PREVIOUS", "TB_NEXT",
    "TB_VARIATIONS", "TB_TOOLS",
    "TB_PASTE_PGN", "TB_READ_PGN", "TB_SAVE", "TB_SAVE_AS", "TB_OPEN",
    "TB_LEVEL", "TB_SETTINGS", "TB_ENGINES"
  ],

  "toolbar_inject": ["caissa:fritz_level", "caissa:switch_mode"],

  "config_section": null,
  "style": "Modern Fritz",
  "icons": "MIDNIGHT",
  "font": null,
  "defaults": {},
  "layout": {
    "fit_board_to_window": true,
    "default_size": [1280, 860],
    "right_col_width": 420
  }
}
