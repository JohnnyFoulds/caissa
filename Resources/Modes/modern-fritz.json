    "TB_PAUSE", "TB_CONTINUE",
    "TB_CONFIG", "TB_UTILITIES",
    "TB_ADVICE", "TB_HELP",
    "TB_PREVIOUS", "TB_NEXT",
    "TB_VARIATIONS", "TB_TOOLS",
    "TB_LEVEL", "TB_SETTINGS", "TB_ENGINES",
    "TB_PASTE_PGN", "TB_READ_PGN", "TB_SAVE", "TB_SAVE_AS", "TB_OPEN"
