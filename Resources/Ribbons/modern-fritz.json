        {
          "id": "analysis.engine",
          "label": "Engine",
          "slots": [
            { "key": "TB_UTILITIES", "size": "small" }
          ]
        }
      ]
    },
    {
      "id": "opening",
      "label": "Opening",
      "groups": [
        {
          "id": "opening.replay",
          "label": "Replay",
          "slots": [
            { "key": "TB_REPLAY",       "size": "small" },
            { "key": "TB_PGN_REPLAY",   "size": "small" }
          ]
        }
      ]
    },
    {
      "id": "engine",
      "label": "Engine",
