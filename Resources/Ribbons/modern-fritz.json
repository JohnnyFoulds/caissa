{
  "$schema_version": 1,
  "default_tab": "home",
  "missing_key_policy": "disable",
  "quick_access": [
    "TB_CLOSE", "TB_CANCEL", "TB_QUIT",
    "TB_STOP", "TB_TUTOR_STOP", "TB_END_REPLAY",
    "TB_PREVIOUS", "TB_NEXT",
    "TB_OPTIONS", "caissa:switch_mode"
  ],
  "overflow": { "tab": "home", "group": "more", "label": "More" },
  "tabs": [
    {
      "id": "home",
      "label": "Home",
      "groups": [
        {
          "id": "home.game",
          "label": "Game",
          "slots": [
            { "key": "caissa:fritz_level", "size": "large", "label": "New Game" },
            { "key": "TB_RESIGN",  "size": "small" },
            { "key": "TB_DRAW",    "size": "small" },
            { "key": "TB_REINIT", "size": "small" },
            { "key": "TB_TAKEBACK", "size": "small" },
            { "key": "TB_PAUSE",  "size": "small" },
            { "key": "TB_CONTINUE", "size": "small" }
          ]
        },
        {
          "id": "home.panes",
          "label": "Panes",
          "kind": "panes",
          "panes": [
            { "pane": "player_header",  "label": "Players" },
            { "pane": "analysis_table", "label": "Engine analysis" },
            { "pane": "eval_graph",     "label": "Eval profile" },
            { "pane": "pgn",            "label": "Notation" },
            { "pane": "eval_bar",       "label": "Eval bar" }
          ]
        }
      ]
    },
    {
      "id": "file",
      "label": "File",
