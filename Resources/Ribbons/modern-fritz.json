{
  "$schema_version": 1,
  "default_tab": "home",
  "missing_key_policy": "disable",
  "quick_access": [
    "TB_CLOSE", "TB_CANCEL", "TB_END_REPLAY",
    "TB_STOP", "TB_TUTOR_STOP",
    "TB_PREVIOUS", "TB_NEXT"
  ],
  "tabs": [
    {
      "id": "file",
      "label": "File",
      "kind": "backstage",
      "items": [
        { "key": "caissa:fritz_level", "label": "New Game..." },
        { "key": "TB_OPEN",            "label": "Open..." },
        { "key": "TB_SAVE",            "label": "Save" },
        { "key": "TB_SAVE_AS",         "label": "Save As..." },
        { "key": "TB_READ_PGN",        "label": "Import PGN..." },
        { "key": "TB_PASTE_PGN",       "label": "Paste PGN" },
        { "separator": true },
        { "key": "TB_OPTIONS",         "label": "Options..." },
        { "key": "TB_ENGINES",         "label": "Engines..." },
        { "separator": true },
        { "key": "caissa:switch_mode",  "label": "Switch Mode..." },
        { "key": "caissa:switch_theme", "label": "Switch Theme..." },
        { "separator": true },
        { "key": "TB_QUIT",            "label": "Quit" }
      ]
    },
    {
      "id": "home",
      "label": "Home",
      "groups": [
        {
          "id": "home.play",
          "label": "Play",
          "slots": [
            { "key": "caissa:fritz_level", "size": "large", "label": "New Game", "has_dropdown": true },
            { "key": "TB_LEVEL",           "size": "large", "label": "Levels" }
          ]
        },
        {
          "id": "home.game",
          "label": "Game",
          "slots": [
            { "key": "TB_RESIGN",   "size": "small" },
            { "key": "TB_DRAW",     "size": "small", "label": "Offer Draw" },
            { "key": "TB_REINIT",   "size": "small", "label": "Restart" },
            { "key": "TB_TAKEBACK", "size": "small" }
          ]
        },
        {
          "id": "home.coaching",
          "label": "Coaching",
          "slots": [
            { "key": "TB_ADVICE", "size": "small", "label": "Hint" },
            { "key": "TB_HELP",   "size": "small", "label": "Suggestion" }
          ]
        },
        {
          "id": "home.panes",
          "label": "Panes",
          "kind": "panes",
          "panes": [
            { "pane": "player_header",  "label": "Players" },
            { "pane": "analysis_table", "label": "Engine analysis" },
            { "pane": "eval_graph",     "label": "Eval profile" },
            { "pane": "pgn",            "label": "Notation" },
            { "pane": "eval_bar",       "label": "Eval bar" }
          ]
        }
      ]
    },
    {
      "id": "board",
      "label": "Board",
      "groups": [
        {
          "id": "board.board",
          "label": "Board",
          "slots": [
            { "key": "caissa:flip_board", "size": "large", "label": "Flip Board" }
          ]
        },
        {
          "id": "board.pieces",
          "label": "Pieces",
          "slots": [
            { "key": "caissa:piece_style", "size": "large", "label": "Piece Style",   "has_dropdown": true },
            { "key": "caissa:sq_color",    "size": "large", "label": "Square Color", "has_dropdown": true }
          ]
        },
        {
          "id": "board.display",
          "label": "Display",
          "kind": "checkboxes",
          "items": [
            { "key": "caissa:board_coordinates", "label": "Coordinates", "default": true  },
            { "key": "caissa:board_arrows",      "label": "Show arrows", "default": true  },
            { "key": "caissa:board_hints",       "label": "Show hints",  "default": false }
          ]
        }
      ]
    },
    {
      "id": "analysis",
      "label": "Analysis",
      "groups": [
        {
          "id": "analysis.engine",
          "label": "Engine",
          "slots": [
            { "key": "caissa:infinite_analysis", "size": "large", "label": "Analyse", "toggle": true },
            { "key": "TB_STOP",                  "size": "small", "label": "Play Now" },
            { "key": "TB_PAUSE",                 "size": "small", "label": "Pause" },
            { "key": "TB_CONTINUE",              "size": "small", "label": "Continue" }
          ]
        },
        {
          "id": "analysis.navigate",
          "label": "Navigate",
          "slots": [
            { "key": "TB_PREVIOUS",   "size": "small", "label": "Previous" },
            { "key": "TB_NEXT",       "size": "small", "label": "Next" },
            { "key": "TB_VARIATIONS", "size": "small", "label": "Variations" }
          ]
        },
        {
          "id": "analysis.tools",
          "label": "Tools",
          "slots": [
            { "key": "TB_CONFIG",    "size": "small" },
            { "key": "TB_UTILITIES", "size": "small" },
            { "key": "TB_TOOLS",     "size": "small" }
          ]
        }
      ]
    },
    {
      "id": "engine",
      "label": "Engine",
      "groups": [
        {
          "id": "engine.select",
          "label": "Engine",
          "slots": [
            { "key": "caissa:select_engine", "size": "large", "label": "Select Engine", "has_dropdown": true }
          ]
        },
        {
          "id": "engine.settings",
          "label": "Settings",
          "slots": [
            { "key": "TB_ENGINES",      "size": "small", "label": "Engine Properties" },
            { "key": "TB_SETTINGS",     "size": "small", "label": "UCI Options" }
          ]
        },
        {
          "id": "engine.kibitzer",
          "label": "Kibitzer",
          "slots": [
            { "key": "caissa:kibitzer", "size": "small", "label": "Kibitzer" }
          ]
        }
      ]
    },
    {
      "id": "view",
      "label": "View",
      "groups": [
        {
          "id": "view.layout",
          "label": "Layout",
          "slots": [
            { "key": "caissa:std_layout", "size": "large", "label": "Standard Layouts", "has_dropdown": true },
            { "key": "caissa:fullscreen", "size": "large", "label": "Full Screen" }
          ]
        },
        {
          "id": "view.panes",
          "label": "Panes",
          "kind": "panes",
          "panes": [
            { "pane": "player_header",  "label": "Players" },
            { "pane": "analysis_table", "label": "Engine analysis" },
            { "pane": "eval_graph",     "label": "Eval profile" },
            { "pane": "pgn",            "label": "Notation" },
            { "pane": "eval_bar",       "label": "Eval bar" }
          ]
        }
      ]
    }
  ]
}
