        {
          "id": "file.pgn",
          "label": "PGN",
          "slots": [
            { "key": "TB_OPEN",      "size": "small" },
            { "key": "TB_SAVE",      "size": "small" },
            { "key": "TB_SAVE_AS",   "size": "small" },
            { "key": "TB_READ_PGN",  "size": "small" },
            { "key": "TB_PASTE_PGN", "size": "small" }
          ]
        }
      ]
    },
    {
      "id": "board",
      "label": "Board",
      "groups": [
        {
          "id": "board.view",
          "label": "View",
          "slots": [
            { "key": "TB_VARIATIONS", "size": "small" },
            { "key": "TB_TOOLS",      "size": "small" },
            { "key": "TB_CONFIG",     "size": "small" }
          ]
        }
      ]
    },
    {
      "id": "training",
      "label": "Training",
      "groups": [
        {
          "id": "training.coach",
          "label": "Coach",
          "slots": [
            { "key": "TB_ADVICE",   "size": "small" },
            { "key": "TB_HELP",     "size": "small" }
          ]
        }
      ]
    },
    {
      "id": "analysis",
      "label": "Analysis",
