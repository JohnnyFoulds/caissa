{
  "version": "1",
  "captured_at": "2026-08-28",
  "notes": "Golden wire contract for RemoteControl — all 25 dispatch-table verbs. Recorded against the pre-Phase-2 binary. The contract covers response KEY SETS only (not exact values), so tests remain green across config/theme/game state changes while still catching structural regressions introduced by the Phase-2 refactor.",
  "probes": [
    {
      "id": "ping",
      "cmd": "ping",
      "keys": ["ok"],
      "requires_game": false,
      "notes": "Always ok; no app state required"
    },
    {
      "id": "info",
      "cmd": "info",
      "keys": ["caissa_theme", "style_mode", "icons", "style"],
      "requires_game": false,
      "notes": "Returns current theme/style config"
    },
    {
      "id": "themes",
      "cmd": "themes",
      "keys": ["themes"],
      "requires_game": false,
      "notes": "Lists available theme names"
    },
    {
      "id": "theme",
      "cmd": "theme Midnight",
      "keys": ["ok", "theme"],
      "requires_game": false,
      "notes": "Applies a theme; uses Midnight (no-op if already active)"
    },
    {
      "id": "screenshot",
      "cmd": "screenshot /tmp/caissa-rc-contract-check.png",
      "keys": ["ok", "path"],
      "requires_game": false,
      "notes": "Saves a screenshot and returns the path"
    },
    {
      "id": "menu",
      "cmd": "menu __nonexistent_rc_contract__",
      "keys": ["error"],
      "requires_game": false,
      "notes": "Error path — unknown menu key"
    },
    {
      "id": "action",
      "cmd": "action __nonexistent_rc_contract__",
      "keys": ["ok", "key"],
      "requires_game": false,
      "notes": "action silently ignores unknown keys; always returns ok+key when procesador is live"
    },
    {
      "id": "toolbar_info",
      "cmd": "toolbar_info",
      "keys": ["count", "toolbar_size", "device_pixel_ratio", "buttons"],
