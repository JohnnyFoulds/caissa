      "notes": "Returns all top-level visible windows"
    },
    {
      "id": "dump_ui",
      "cmd": "dump_ui 1",
      "keys": ["roots"],
      "requires_game": false,
      "notes": "Returns widget tree at depth 1"
    },
    {
      "id": "find_widget",
      "cmd": "find_widget __xyzzy_rc_contract__",
