#!/usr/bin/env python3
"""Quick remote-control helper — send one command and print the JSON response."""
import socket, json, sys

SOCK = "/tmp/caissa-control.sock"
cmd = " ".join(sys.argv[1:]) if len(sys.argv) > 1 else "ping"

s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.connect(SOCK)
s.sendall((cmd + "\n").encode())
data = b""
while b"\n" not in data:
    data += s.recv(4096)
s.close()
print(json.dumps(json.loads(data.strip()), indent=2))
