#!/Users/johannes/code/lucaschess/.venv/bin/python3
"""
tools/caissa-retro — UCI entry point for the Battle Chess Retro Engine.

Usage::

    tools/caissa-retro

Communicates via stdin/stdout using the UCI chess protocol.  Configure the
ROM path via setoption before sending ``go``::

    setoption name EmuRomPath value /path/to/battle_chess.bin

See docs/retro/rom-setup.md and docs/retro/uci-options.md.
"""

import os
import sys

# Ensure bin/ is on the path so Code.* imports resolve when run directly.
_REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
_BIN = os.path.join(_REPO_ROOT, "bin")
if _BIN not in sys.path:
    sys.path.insert(0, _BIN)

from Code.Retro.Uci import main  # noqa: E402

if __name__ == "__main__":
    main()
