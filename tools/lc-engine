#!/bin/bash
# lc-engine — host-side Docker engine bridge
#
# Usage:
#   lc-engine --ensure          # idempotently start the container (called by lucaschess launcher)
#   lc-engine --stop            # stop the container
#   lc-engine --status          # print container status
#   lc-engine --build           # (re)build the image
#   lc-engine MODE EXEC_PATH    # run an engine (used by per-engine wrapper scripts)
#
# MODE is one of: direct | qemu64 | wine | wine32
# EXEC_PATH is the absolute host path to the engine binary.

set -e

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONTAINER="lucas-engines"
IMAGE="lucas-engines:latest"
WINEPREFIX_VOL="lucas-wine"

case "${1:-}" in
    --build)
        echo "Building $IMAGE ..."
        docker build --platform linux/amd64 \
            -f "$REPO/tools/docker/Dockerfile.engines" \
            -t "$IMAGE" \
            "$REPO/tools/docker/"
        echo "Done."
        exit 0
        ;;
    --ensure)
        # Idempotent: start only if not already running.
        STATUS=$(docker inspect -f '{{.State.Status}}' "$CONTAINER" 2>/dev/null || echo "missing")
        case "$STATUS" in
            running) exit 0 ;;
            paused)  docker unpause "$CONTAINER" >/dev/null; exit 0 ;;
            exited|created)
                docker start "$CONTAINER" >/dev/null
                exit 0
                ;;
            missing)
                # Race-safe: if two processes start at once the second `docker run`
                # fails with "container name already in use" — that is harmless.
                docker run -d --name "$CONTAINER" --platform linux/amd64 \
                    -v "$REPO:$REPO" \
                    -v "$WINEPREFIX_VOL:/wine" \
                    -e WINEPREFIX=/wine/prefix \
                    -e WINEDEBUG=-all \
                    -e WINEARCH=win64 \
                    "$IMAGE" sleep infinity >/dev/null 2>&1 || true
                # If no Wine prefix exists yet, init it (headless)
                sleep 0.5
                docker exec "$CONTAINER" sh -c \
                    'test -f "$WINEPREFIX/system.reg" || (wine wineboot --init 2>/dev/null; true)' \
                    2>/dev/null || true
                ;;
        esac
        exit 0
        ;;
    --stop)
        docker stop "$CONTAINER" 2>/dev/null && echo "Stopped." || echo "Not running."
        exit 0
        ;;
    --status)
        docker inspect -f 'Status: {{.State.Status}}' "$CONTAINER" 2>/dev/null || echo "Status: missing"
        exit 0
        ;;
    --*)
        echo "Unknown option: $1" >&2; exit 1
        ;;
esac

# Normal usage: lc-engine MODE /abs/path/to/engine
MODE="$1"
EXE="$2"
ENGINE_DIR="$(dirname "$EXE")"

# Preflight: fail fast with a clear diagnostic instead of blocking a UCI pipe forever.
if ! command -v docker &>/dev/null; then
    printf 'lc-engine: Docker not found — bridged engines are unavailable.\nInstall Docker Desktop to use the full engine roster.\n' >&2
    exit 1
fi
_STATUS=$(docker inspect -f '{{.State.Status}}' "$CONTAINER" 2>/dev/null || echo "missing")
if [ "$_STATUS" != "running" ] && [ "$_STATUS" != "paused" ]; then
    # Try once to start the container, then re-check.
    "${BASH_SOURCE[0]}" --ensure 2>/dev/null || true
    _STATUS=$(docker inspect -f '{{.State.Status}}' "$CONTAINER" 2>/dev/null || echo "missing")
    if [ "$_STATUS" != "running" ] && [ "$_STATUS" != "paused" ]; then
        printf 'lc-engine: container "%s" not running (status: %s).\nStart Docker Desktop and retry, or use the native engines.\n' "$CONTAINER" "$_STATUS" >&2
        exit 1
    fi
fi

# -i: keep stdin open for UCI pipe (never -t: TTY mangles UCI line endings)
exec docker exec -i -w "$ENGINE_DIR" "$CONTAINER" /opt/lc/lc-run "$MODE" "$EXE"
